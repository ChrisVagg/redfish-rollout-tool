{
 "uid": "prod-fleet",
 "title": "Prod · Fleet manager",
 "description": "Every BMC of a site, read by poller.py exporter: answering, health, firmware and readings near their thresholds. A host's name opens its own dashboard.",
 "schemaVersion": 39,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "redfish",
  "prod"
 ],
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "prod"
   ],
   "title": "Prod",
   "asDropdown": false,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "site",
    "label": "Site",
    "type": "constant",
    "query": "prod",
    "hide": 2,
    "current": {
     "text": "prod",
     "value": "prod"
    },
    "options": [
     {
      "text": "prod",
      "value": "prod",
      "selected": true
     }
    ]
   },
   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 0,
    "query": {
     "query": "label_values(redfish_up{site=\"$site\"}, host)",
     "refId": "host"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "BMCs answering",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 1,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(redfish_up{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Not answering",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 2,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(redfish_up{site=\"$site\",host=~\"$host\"} == 0) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Worst health",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 3,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(redfish_health{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "description": "The worst Status.Health of any component of the selected hosts",
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "OK",
         "color": "green",
         "index": 0
        },
        "1": {
         "text": "Warning",
         "color": "orange",
         "index": 1
        },
        "2": {
         "text": "Critical",
         "color": "red",
         "index": 2
        },
        "-1": {
         "text": "-",
         "color": "text",
         "index": 3
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Readings past critical",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 4,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(redfish_reading_crossed{site=\"$site\",host=~\"$host\"} >= 2) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "description": "Readings at or past a critical or fatal threshold, upper or lower",
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Shortest BMC uptime",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 5,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min(time() - redfish_manager_last_reset_timestamp_seconds{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "description": "Since the last reset of a BMC (Manager.LastResetTime): short after an update",
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Longest crawl",
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 6,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(redfish_crawl_seconds{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "description": "The longest read of one BMC's Redfish tree",
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "type": "table",
   "title": "Hosts",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 7,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_up{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_health{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(count by (host) (redfish_health{site=\"$site\",host=~\"$host\"} > 0) or 0 * max by (host) (redfish_up{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_reading_crossed{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(min by (host) (time() - redfish_manager_last_reset_timestamp_seconds{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_crawl_seconds{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "F",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_resources{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "G",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_failed_requests{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "H",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "description": "One row per BMC: the equipment (the inventory's vendor, project and rack, the BMC's Manufacturer and Model), answering Redfish, its worst health, how many components aren't OK, how far its readings are past their thresholds, time since its last reset, how long its crawl took, how many resources it has and how many GETs failed (what they would have read is missing). A host opens its own dashboard.",
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "site": true,
       "pipeline": true
      },
      "renameByName": {
       "host": "Host",
       "vendor": "Vendor",
       "manufacturer": "Manufacturer",
       "model": "Model",
       "project": "Project",
       "rack": "Rack",
       "Value #A": "Redfish",
       "Value #B": "Worst health",
       "Value #C": "Not OK",
       "Value #D": "Readings",
       "Value #E": "BMC uptime",
       "Value #F": "Crawl",
       "Value #G": "Resources",
       "Value #H": "Failed GETs"
      },
      "indexByName": {
       "host": 0,
       "vendor": 1,
       "manufacturer": 2,
       "model": 3,
       "project": 4,
       "rack": 5
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Host"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "${__value.text}: the host's dashboard",
          "targetBlank": false,
          "url": "/d/prod-host/prod-host?var-host=${__value.raw}&${__url_time_range}"
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Redfish"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "1": {
            "text": "up",
            "color": "green",
            "index": 0
           },
           "0": {
            "text": "down",
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Worst health"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "OK",
            "color": "green",
            "index": 0
           },
           "1": {
            "text": "Warning",
            "color": "orange",
            "index": 1
           },
           "2": {
            "text": "Critical",
            "color": "red",
            "index": 2
           },
           "-1": {
            "text": "-",
            "color": "text",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Readings"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "within",
            "color": "green",
            "index": 0
           },
           "1": {
            "text": "caution",
            "color": "orange",
            "index": 1
           },
           "2": {
            "text": "critical",
            "color": "red",
            "index": 2
           },
           "3": {
            "text": "fatal",
            "color": "dark-red",
            "index": 3
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "BMC uptime"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Crawl"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Failed GETs"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "orange",
           "value": 1
          }
         ]
        }
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": []
   }
  },
  {
   "type": "state-timeline",
   "title": "Answering Redfish",
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 8,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "redfish_up{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "{{host}}",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "description": "Each BMC over time: a firmware update shows as the reset's gap",
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "up",
         "color": "green",
         "index": 0
        },
        "0": {
         "text": "down",
         "color": "red",
         "index": 1
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.8,
    "legend": {
     "showLegend": false
    }
   }
  },
  {
   "type": "table",
   "title": "Firmware: hosts per version",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 9,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 9,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (manufacturer, model, component, version) ((redfish_firmware_info{site=\"$site\",host=~\"$host\"}) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "description": "Per hardware model, every firmware component's running versions and how many hosts run each: two rows for one component of one model is drift",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "site": true,
       "pipeline": true
      },
      "renameByName": {
       "vendor": "Vendor",
       "manufacturer": "Manufacturer",
       "model": "Model",
       "project": "Project",
       "rack": "Rack",
       "component": "Component",
       "version": "Version",
       "Value": "Hosts"
      },
      "indexByName": {
       "manufacturer": 0,
       "model": 1,
       "component": 2,
       "version": 3
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": []
   }
  },
  {
   "type": "table",
   "title": "Firmware per host",
   "gridPos": {
    "x": 9,
    "y": 20,
    "w": 15,
    "h": 10
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 10,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(redfish_firmware_info{site=\"$site\",host=~\"$host\"}) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "description": "Each host's firmware components, whether Redfish can update them and how an image gets in, as rollout.py plan reports them",
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "site": true,
       "pipeline": true,
       "Value": true,
       "vendor": true,
       "manufacturer": true,
       "project": true,
       "rack": true
      },
      "renameByName": {
       "host": "Host",
       "vendor": "Vendor",
       "manufacturer": "Manufacturer",
       "model": "Model",
       "project": "Project",
       "rack": "Rack",
       "component": "Component",
       "version": "Version",
       "updateable": "Updateable",
       "push": "Push",
       "pull": "Pull",
       "software_id": "SoftwareId"
      },
      "indexByName": {
       "host": 0,
