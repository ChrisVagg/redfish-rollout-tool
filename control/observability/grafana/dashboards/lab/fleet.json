{
 "uid": "lab-fleet",
 "title": "Lab · Fleet manager",
 "description": "Every BMC of a site, read by poller.py exporter: answering, health, firmware and readings near their thresholds. A host's name opens its own dashboard.",
 "schemaVersion": 39,
 "editable": false,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "redfish",
  "lab"
 ],
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "lab"
   ],
   "title": "Lab",
   "asDropdown": false,
   "includeVars": false,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "site",
    "label": "Site",
    "type": "constant",
    "query": "lab",
    "hide": 2,
    "current": {
     "text": "lab",
     "value": "lab"
    },
    "options": [
     {
      "text": "lab",
      "value": "lab",
      "selected": true
     }
    ]
   },
   {
    "name": "host",
    "label": "Host",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "hide": 0,
    "query": {
     "query": "label_values(redfish_up{site=\"$site\"}, host)",
     "refId": "host"
    },
    "refresh": 2,
    "sort": 1,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    }
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "BMCs answering",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 1,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(redfish_up{site=\"$site\",host=~\"$host\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#00c9a7",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value"
   },
   "transparent": true
  },
  {
   "type": "stat",
   "title": "Not answering",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 2,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count((redfish_up{site=\"$site\",host=~\"$host\"} == 0) unless on (host) max by (host) (max_over_time(((rollout_host_step{site=\"$site\",host=~\"$host\"} > 0 < 10) and on (pipeline, stage) (rollout_running{site=\"$site\"} == 1) and on (pipeline, stage) (time() - push_time_seconds{job=\"rollout\",site=\"$site\"} < 1200))[1m:15s]))) or vector(0)",
     "legendFormat": "down",
     "refId": "A",
     "instant": false,
     "range": true
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count((redfish_up{site=\"$site\",host=~\"$host\"} == 0) and on (host) max by (host) (max_over_time(((rollout_host_step{site=\"$site\",host=~\"$host\"} > 0 < 10) and on (pipeline, stage) (rollout_running{site=\"$site\"} == 1) and on (pipeline, stage) (time() - push_time_seconds{job=\"rollout\",site=\"$site\"} < 1200))[1m:15s]))) or vector(0)",
     "legendFormat": "updating",
     "refId": "B",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#00c9a7",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "updating"
      },
      "properties": [
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "#00c9a7",
           "value": null
          },
          {
           "color": "#3ee6c4",
           "value": 1
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name"
   },
   "transparent": true
  },
  {
