  {
   "type": "table",
   "title": "Hosts",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 9
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "id": 7,
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_up{site=\"$site\",host=~\"$host\"}) + on (host) (2 * (max by (host) (max_over_time(((rollout_host_step{site=\"$site\",host=~\"$host\"} > 0 < 10) and on (pipeline, stage) (rollout_running{site=\"$site\"} == 1) and on (pipeline, stage) (time() - push_time_seconds{job=\"rollout\",site=\"$site\"} < 1200))[1m:15s])) > bool 0) or 0 * max by (host) (redfish_up{site=\"$site\",host=~\"$host\"}))) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_health{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "B",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(count by (host) (redfish_health{site=\"$site\",host=~\"$host\"} > 0) or 0 * max by (host) (redfish_up{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "C",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_reading_crossed{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "D",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(min by (host) (time() - redfish_manager_last_reset_timestamp_seconds{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "E",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_crawl_seconds{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "F",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_resources{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "G",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(max by (host) (redfish_failed_requests{site=\"$site\",host=~\"$host\"})) * on (host) group_left (vendor, manufacturer, model, project, rack) redfish_host_info{site=\"$site\",host=~\"$host\"}",
     "legendFormat": "",
     "refId": "H",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
